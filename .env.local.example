# Por padrao o teste local usa SQLite local, mais rapido para validacao.
# Para testar gravando direto no PostgreSQL Render, descomente as duas linhas:
# VISIONAI_USE_RENDER_DB=1
# DATABASE_URL=postgresql://usuario:senha@host/database
VISIONAI_LAB_URL=https://visionai-laboratorio.onrender.com/laboratorio

# Ajustes opcionais do modo local
VISIONAI_UI_CAPTURE_SCORE_MIN=82
VISIONAI_MIN_STABLE_SECONDS=0.30
VISIONAI_UI_CAPTURE_HOLD_MS=180
VISIONAI_UI_TOTAL_CAPTURES=1
VISIONAI_UI_STABLE_SAMPLES=2
VISIONAI_UI_STABLE_WINDOW_MS=1200
VISIONAI_UI_MAX_DP_SPREAD=0.9
VISIONAI_UI_MAX_DP_TREND=0.45
VISIONAI_UI_BLOCK_DP_MARGIN=0.3
VISIONAI_UI_PHOTO_MAX_WIDTH=720
VISIONAI_UI_PHOTO_QUALITY=0.68
VISIONAI_USE_MEDIAN_RESULT=1
VISIONAI_SCALE_MULTIPLIER=1.00
VISIONAI_MIN_CAPTURE_IRIS_PX=10.0
VISIONAI_MAX_CAPTURE_IRIS_PX=14.5
VISIONAI_IDEAL_CAPTURE_IRIS_MIN_PX=11.0
VISIONAI_IDEAL_CAPTURE_IRIS_MAX_PX=13.9
VISIONAI_UI_CROP_PADDING_X=1.36
VISIONAI_UI_CROP_PADDING_Y=1.22
VISIONAI_MAX_DNP_DIFF_MM=5.0
VISIONAI_MAX_APPROVAL_YAW=4.5
VISIONAI_RESULT_PREVIEW_MS=5500

# Admin central de licencas
VISIONAI_ADMIN_PORT=5002
VISIONAI_ADMIN_USER=admin
VISIONAI_ADMIN_PASSWORD=visionai-admin
VISIONAI_ADMIN_DB_PATH=data/visionai_admin.db
